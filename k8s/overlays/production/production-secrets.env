# PRODUCTION SECRETS - NEVER COMMIT REAL VALUES
# Use SealedSecrets, External Secrets Operator, or Vault Agent Injector

# Database
DATABASE_URL=postgresql://crm:PROD_PASSWORD@postgres.crm-production.svc.cluster.local:5432/crm
POSTGRES_PASSWORD=PROD_PASSWORD

# Redis
REDIS_URL=redis://:PROD_REDIS_PASSWORD@redis.crm-production.svc.cluster.local:6379
REDIS_PASSWORD=PROD_REDIS_PASSWORD

# Auth - USE STRONG UNIQUE SECRETS
JWT_SECRET=PROD_JWT_SECRET_64_CHARS_MINIMUM
SESSION_SECRET=PROD_SESSION_SECRET_64_CHARS_MINIMUM
SESSION_COOKIE=crm_session
SESSION_TTL_SECONDS=604800

# Encryption - 64 char hex key
MICROSOFT_CRYPTO_KEY=PROD_64_CHAR_HEX_KEY

# MinIO
MINIO_ROOT_USER=crm
MINIO_ROOT_PASSWORD=PROD_MINIO_PASSWORD
MINIO_PASSWORD=PROD_MINIO_PASSWORD

# Stripe (PRODUCTION KEYS)
STRIPE_SECRET_KEY=sk_live_PROD_KEY
STRIPE_WEBHOOK_SECRET=whsec_PROD_KEY
STRIPE_PRICE_STARTER=price_PROD_STARTER
STRIPE_PRICE_PROFESSIONAL=price_PROD_PROFESSIONAL
STRIPE_PRICE_ENTERPRISE=price_PROD_ENTERPRISE

# OAuth (Production credentials)
GOOGLE_CLIENT_ID=PROD_CLIENT_ID
GOOGLE_CLIENT_SECRET=PROD_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.crm.example.com/api/auth/google/callback
MICROSOFT_CLIENT_ID=PROD_CLIENT_ID
MICROSOFT_CLIENT_SECRET=PROD_CLIENT_SECRET
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://api.crm.example.com/api/auth/microsoft/callback

# External APIs
CLEARBIT_API_KEY=sk_live_PROD_KEY
APOLLO_API_KEY=PROD_API_KEY
SENTRY_DSN=https://prod@o1.ingest.sentry.io/123456
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PROD_WEBHOOK

# SMTP Production
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.PROD_API_KEY
SMTP_FROM=noreply@crm.example.com

# Frontend
VITE_API_URL=https://api.crm.example.com
VITE_METABASE_URL=https://metabase.crm.example.com