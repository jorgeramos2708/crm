# STAGING SECRETS - Replace with actual values from your secret manager
# DO NOT COMMIT REAL VALUES - Use SealedSecrets or External Secrets Operator

# Database
DATABASE_URL=postgresql://crm:staging_password@postgres.crm-staging.svc.cluster.local:5432/crm
POSTGRES_PASSWORD=staging_password

# Redis
REDIS_URL=redis://:staging_redis_password@redis.crm-staging.svc.cluster.local:6379
REDIS_PASSWORD=staging_redis_password

# Auth
JWT_SECRET=staging-jwt-secret-change-in-production-min-32-chars
SESSION_SECRET=staging-session-secret-change-in-production-min-32-chars
SESSION_COOKIE=crm_session
SESSION_TTL_SECONDS=604800

# Encryption
MICROSOFT_CRYPTO_KEY=0977bac398073dfeee3d5223b9ba1a201414227e037ec1825ee50c25a10cc017

# MinIO
MINIO_ROOT_USER=crm
MINIO_ROOT_PASSWORD=staging_minio_password
MINIO_PASSWORD=staging_minio_password

# Stripe (use test keys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_PROFESSIONAL=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME

# OAuth (use staging credentials)
